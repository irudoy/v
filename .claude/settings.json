{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$CLAUDE_PROJECT_DIR/.venv/bin/python\"; [ -x \"$p\" ] || p=python3; exec \"$p\" \"$CLAUDE_PROJECT_DIR/tools/kb/hook.py\""
          }
        ]
      }
    ]
  }
}
