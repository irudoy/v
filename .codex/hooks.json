{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "kb_hook_root=\"$(git rev-parse --show-toplevel)\" || exit 1; kb_hook_python=\"$kb_hook_root/.venv/bin/python\"; [ -x \"$kb_hook_python\" ] || kb_hook_python=python3; exec \"$kb_hook_python\" \"$kb_hook_root/tools/kb/hook.py\""
          }
        ]
      }
    ]
  }
}
