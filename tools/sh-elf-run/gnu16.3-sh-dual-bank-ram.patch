+              fprintf (stderr, "VQ_SH_HIGH_RAM error=invalid_base\n");
+              _Exit (125);
+            }
+        }
       if (value != NULL)
         {
           char *end;
           unsigned long base;
+          unsigned long required = vq_high_ram_layout ? 0x29000UL : 0x10000UL;
           errno = 0;
           base = strtoul (value, &end, 0);
           if (*value < '0' || *value > '9' || *end != 0 || errno != 0
               || base == 0 || (base & 0xffffUL) != 0
