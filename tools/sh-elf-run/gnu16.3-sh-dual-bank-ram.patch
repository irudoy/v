    The enabled 64 KiB window is ordinary flat storage, not a peripheral model.
    Instruction addresses and the target instruction stream are unchanged.  */
 static int vq_high_ram_checked;
+static int vq_high_ram_layout;
 static unsigned int vq_high_ram_base;
 
 static int
+vq_high_ram_mmio_allowed (unsigned int address, unsigned int width)
+{
+  if (width == 1U)
+    {
+      if (address >= 0xfffff010U && address <= 0xfffff016U)
+        return 1;
+      if (address == 0xfffff708U || address == 0xfffff709U)
+        return 1;
+      return 0;
+    }
+  if (width == 2U)
+    {
+      if (address == 0xfffff73aU || address == 0xfffff73cU
+          || address == 0xfffff73eU)
+        return 1;
+      if (address == 0xfffff750U || address == 0xfffff752U
+          || address == 0xfffff754U || address == 0xfffff756U
+          || address == 0xfffff758U || address == 0xfffff75aU
+          || address == 0xfffff75cU || address == 0xfffff75eU)
+        return 1;
+      if (address == 0xfffff708U)
+        return 1;
+      return 0;
+    }
+  return 0;
+}
+
+static int
+vq_ranges_overlap (unsigned long a_start, unsigned long a_size,
+                   unsigned long b_start, unsigned long b_size)
+{
+  return a_start < b_start + b_size && b_start < a_start + a_size;
+}
