<?xml version='1.0' encoding='utf-8'?>
<XDFFORMAT version="1.70">
  <XDFHEADER>
    <flags>0x1</flags>
    <deftitle>1ME3B - VQ HR ECU</deftitle>
    <description>1ME3B definition generated by SHA-bound address projection from canonical JK08A Memgraph facts through defs/JK08A-1ME3B.definition-addresses.csv, defs/1ME3B.dtc.csv, and defs/JK08A.overrides.toml, with target identity from defs/rom-identities.toml. Individual and group DTC patches overlap by design. No editor-side checksum is declared; the flashing workflow handles checksum correction.</description>
    <author>VQ HR ECU project</author>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="8" sigdigits="2" outputtype="1" signed="0" lsbfirst="0" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x180000" regioncolor="0x0" regionflags="0x0" name="Binary File" desc="Exact 1ME3B 0x180000-byte ROM image" />
    <CATEGORY index="0x0" name="Diagnostics / DTC / Disable Groups" />
    <CATEGORY index="0x1" name="Diagnostics / DTC / Individual" />
    <CATEGORY index="0x2" name="Electronic Throttle Control / Accelerator Pedal / Thresholds" />
    <CATEGORY index="0x3" name="Electronic Throttle Control / Requested Torque" />
    <CATEGORY index="0x4" name="Electronic Throttle Control / Throttle Geometry" />
    <CATEGORY index="0x5" name="Fuelling / Compensation" />
    <CATEGORY index="0x6" name="Fuelling / Deceleration Fuel Cut" />
    <CATEGORY index="0x7" name="Fuelling / Injection" />
    <CATEGORY index="0x8" name="Fuelling / Load Model" />
    <CATEGORY index="0x9" name="Fuelling / MAF Scaling" />
    <CATEGORY index="0xA" name="Ignition Timing / Knock Control / Thresholds" />
    <CATEGORY index="0xB" name="Ignition Timing / State Corrections" />
    <CATEGORY index="0xC" name="Limiters / Engine Speed / Driving" />
    <CATEGORY index="0xD" name="Limiters / Engine Speed / Stationary" />
    <CATEGORY index="0xE" name="NATS / Immobilizer" />
    <CATEGORY index="0xF" name="Torque Model / Engine Torque" />
  </XDFHEADER>
  <XDFPATCH uniqueid="0x5AE3" flags="0x0">
    <title>Developer Immobilizer</title>
    <description>Exact 1ME3B only. Bit 0 enables ECM immobilizer enforcement; clearing it bypasses the Developer Immobilizer transitions and releases the engine inhibit. NATS DTC suppression is independent. Hardware evidence covers a JK08A-derived image on a 23710-JK00D ECU; no other image carries a hardware result. Base state: Enabled (Stock). Patched state: Disabled (IMMO OFF).</description>
    <CATEGORYMEM index="0" category="15" />
    <XDFPATCHENTRY name="Developer Immobilizer" address="0x8671" datasize="0x1" patchdata="00" basedata="01" />
  </XDFPATCH>
  <XDFPATCH uniqueid="0xA555" flags="0x0">
    <title>DTC P0306 [index 10] - Cylinder 6 misfire detected</title>
    <description>Exact 1ME3B only. Applying this patch suppresses the DTC descriptor and its mutable attribute as one operation. It does not disable the physical monitor. This patch overlaps its DTC group patch; use individual or group scope consistently.</description>
