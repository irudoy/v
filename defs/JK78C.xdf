<?xml version='1.0' encoding='utf-8'?>
<XDFFORMAT version="1.70">
  <XDFHEADER>
    <flags>0x1</flags>
    <deftitle>JK78C - VQ HR ECU</deftitle>
    <description>JK78C definition generated by SHA-bound address projection from canonical JK08A Memgraph facts through defs/JK08A-JK78C.definition-addresses.csv, defs/JK78C.dtc.csv, and defs/JK08A.overrides.toml, with target identity from defs/rom-identities.toml. Individual and group DTC patches overlap by design. No editor-side checksum is declared; the flashing workflow handles checksum correction. The definition includes target-specific Map 1 through Map 5 storage from the validated address profile. Map 2 through Map 5 are inactive erased ranges in stock firmware and require the project map-switching patch.</description>
    <author>VQ HR ECU project</author>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="8" sigdigits="2" outputtype="1" signed="0" lsbfirst="0" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x100000" regioncolor="0x0" regionflags="0x0" name="Binary File" desc="Exact JK78C 0x100000-byte ROM image" />
    <CATEGORY index="0x0" name="Diagnostics / DTC / Disable Groups" />
    <CATEGORY index="0x1" name="Diagnostics / DTC / Individual" />
    <CATEGORY index="0x2" name="Electronic Throttle Control / Accelerator Pedal / Thresholds" />
    <CATEGORY index="0x3" name="Electronic Throttle Control / Requested Torque" />
    <CATEGORY index="0x4" name="Electronic Throttle Control / Throttle Geometry" />
    <CATEGORY index="0x5" name="Fuelling / Compensation" />
    <CATEGORY index="0x6" name="Fuelling / Deceleration Fuel Cut" />
    <CATEGORY index="0x7" name="Fuelling / Injection" />
    <CATEGORY index="0x8" name="Fuelling / Load Model" />
    <CATEGORY index="0x9" name="Fuelling / MAF Scaling" />
    <CATEGORY index="0xA" name="Ignition Timing / Knock Control / Thresholds" />
    <CATEGORY index="0xB" name="Ignition Timing / State Control" />
    <CATEGORY index="0xC" name="Ignition Timing / State Corrections" />
    <CATEGORY index="0xD" name="Ignition Timing / State Surfaces" />
    <CATEGORY index="0xE" name="Limiters / Engine Speed / Driving" />
    <CATEGORY index="0xF" name="Limiters / Engine Speed / Stationary" />
    <CATEGORY index="0x10" name="Logging / CAN Telemetry" />
    <CATEGORY index="0x11" name="NATS / Immobilizer" />
    <CATEGORY index="0x12" name="Rolling Launch / Activation" />
    <CATEGORY index="0x13" name="Rolling Launch / Ignition Retard" />
    <CATEGORY index="0x14" name="Rolling Launch / Map Enable" />
    <CATEGORY index="0x15" name="Rolling Launch / RPM Hold" />
    <CATEGORY index="0x16" name="Torque Model / Engine Torque" />
  </XDFHEADER>
  <XDFPATCH uniqueid="0xBE70" flags="0x0">
    <title>CAN Telemetry at Startup</title>
    <description>Exact JK78C producer configuration. Disabled is the default. A validated START command on the derived control CAN ID overrides this byte until reset; STOP forces streaming off until reset. Requires the project CAN telemetry runtime. Base state: Disabled (Default). Patched state: Enabled.</description>
    <CATEGORYMEM index="0" category="17" />
    <XDFPATCHENTRY name="CAN Telemetry at Startup" address="0x1F803" datasize="0x1" patchdata="01" basedata="00" />
  </XDFPATCH>
  <XDFPATCH uniqueid="0xED75" flags="0x0">
    <title>Developer Immobilizer</title>
    <description>Exact JK78C only. Bit 0 enables ECM immobilizer enforcement; clearing it bypasses the Developer Immobilizer transitions and releases the engine inhibit. NATS DTC suppression is independent. Hardware evidence covers a JK08A-derived image on a 23710-JK00D ECU; no other image carries a hardware result. Base state: Enabled (Stock). Patched state: Disabled (IMMO OFF).</description>
    <CATEGORYMEM index="0" category="18" />
    <XDFPATCHENTRY name="Developer Immobilizer" address="0x861C" datasize="0x1" patchdata="00" basedata="01" />
  </XDFPATCH>
  <XDFPATCH uniqueid="0xDD7B" flags="0x0">
    <title>Rolling Launch Require Accelerator Pedal</title>
    <description>Exact JK78C. Enabled writes min_pedal=1 and requires a nonzero normalized accelerator-pedal signal for activation. Disabled writes min_pedal=0, which makes the pedal gate unconditional. The signal is not presented as a calibrated pedal percentage. Base state: Enabled. Patched state: Disabled.</description>
    <CATEGORYMEM index="0" category="19" />
    <XDFPATCHENTRY name="Rolling Launch Require Accelerator Pedal" address="0x1E96C" datasize="0x2" patchdata="0000" basedata="0001" />
  </XDFPATCH>
