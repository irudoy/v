<XDFFORMAT version="1.70">
  <XDFHEADER>
    <flags>0x1</flags>
    <deftitle>JK78C - VQ HR ECU</deftitle>
    <description>JK78C definition generated by SHA-bound address projection from canonical JK08A Memgraph facts through defs/JK08A-JK78C.definition-addresses.csv and defs/JK08A.overrides.toml, with target identity from defs/rom-identities.toml. No editor-side checksum is declared. The project has no verified JK78C checksum layout, so edited images are not flash-ready.</description>
    <author>VQ HR ECU project</author>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="8" sigdigits="2" outputtype="1" signed="0" lsbfirst="0" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x100000" regioncolor="0x0" regionflags="0x0" name="Binary File" desc="Exact JK78C 0x100000-byte ROM image" />
