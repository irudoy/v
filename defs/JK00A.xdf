    <XDFAXIS id="x" uniqueid="0x0" flags="0x0">
      <EMBEDDEDDATA mmedaddress="0x2378C" mmedelementsizebits="16" mmedcolcount="16" mmedmajorstridebits="16" mmedminorstridebits="0" />
