    <XDFAXIS id="y" uniqueid="0x0" flags="0x0">
      <EMBEDDEDDATA mmedaddress="0x1399A" mmedelementsizebits="8" mmedcolcount="16" mmedmajorstridebits="8" mmedminorstridebits="0" />
      <units>RPM [cand]</units>
      <indexcount>16</indexcount>
      <decimalpl>0</decimalpl>
      <outputtype>1</outputtype>
