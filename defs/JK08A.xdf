<?xml version='1.0' encoding='utf-8'?>
<XDFFORMAT version="1.70">
  <XDFHEADER>
    <flags>0x1</flags>
    <deftitle>JK08A - VQ HR ECU</deftitle>
    <description>Exact JK08A definition generated from Memgraph, defs/JK08A.dtc.csv, and defs/JK08A.overrides.toml. Individual and group DTC patches overlap by design. No editor-side checksum is declared; the flashing workflow handles checksum correction.</description>
    <author>VQ HR ECU project</author>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="8" sigdigits="2" outputtype="1" signed="0" lsbfirst="0" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x100000" regioncolor="0x0" regionflags="0x0" name="Binary File" desc="Exact JK08A 0x100000-byte ROM image" />
    <CATEGORY index="0x0" name="AFR / Lambda" />
    <CATEGORY index="0x1" name="Airflow" />
    <CATEGORY index="0x2" name="Diagnostics / DTC / Disable Groups" />
    <CATEGORY index="0x3" name="Diagnostics / DTC / Individual" />
    <CATEGORY index="0x4" name="Diagnostics / Knock Sensor Monitor" />
    <CATEGORY index="0x5" name="Filters" />
    <CATEGORY index="0x6" name="Fuel" />
    <CATEGORY index="0x7" name="Fuel Delivery / Fuel Cut / Main" />
    <CATEGORY index="0x8" name="Fuel Delivery / Main" />
    <CATEGORY index="0x9" name="Ignition / Transient Correction" />
    <CATEGORY index="0xA" name="Ignition Timing / Knock Control / Main" />
    <CATEGORY index="0xB" name="Ignition Timing / Knock Control / Thresholds" />
    <CATEGORY index="0xC" name="Ignition Timing / Main" />
    <CATEGORY index="0xD" name="Internal Calculations" />
    <CATEGORY index="0xE" name="Limiters" />
    <CATEGORY index="0xF" name="Limiters / Stationary Rev Limiter" />
    <CATEGORY index="0x10" name="Load" />
    <CATEGORY index="0x11" name="NATS / Immobilizer" />
    <CATEGORY index="0x12" name="Reference Axes" />
    <CATEGORY index="0x13" name="Throttle / Accelerator Pedal / Thresholds" />
    <CATEGORY index="0x14" name="Unidentified Calibrations" />
  </XDFHEADER>
  <XDFPATCH uniqueid="0x3B07" flags="0x0">
    <title>Developer Immobilizer</title>
    <description>Exact JK08A only. Bit 0 enables ECM immobilizer enforcement. Vehicle start and operation verified. NATS DTC suppression is independent. Base state: Enabled (Stock). Patched state: Disabled (IMMO OFF).</description>
    <CATEGORYMEM index="0" category="18" />
    <XDFPATCHENTRY name="Developer Immobilizer" address="0x8725" datasize="0x1" patchdata="00" basedata="01" />
  </XDFPATCH>
  <XDFPATCH uniqueid="0x30F6" flags="0x0">
    <title>DTC P0420 [index 17] - Catalyst efficiency bank 1</title>
    <description>Exact JK08A only. Applying this patch suppresses the DTC descriptor and its mutable attribute as one operation. It does not disable the physical monitor. This patch overlaps its DTC group patch; use individual or group scope consistently.</description>
