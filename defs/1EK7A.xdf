<?xml version='1.0' encoding='utf-8'?>
<XDFFORMAT version="1.70">
  <XDFHEADER>
    <flags>0x1</flags>
    <deftitle>1EK7A - VQ HR ECU</deftitle>
    <description>1EK7A definition generated by SHA-bound address projection from canonical JK08A Memgraph facts through defs/JK08A-1EK7A.definition-addresses.csv, defs/1EK7A.dtc.csv, and defs/JK08A.overrides.toml, with target identity from defs/rom-identities.toml. Individual and group DTC patches overlap by design. This definition supports offline calibration editing. TunerPro saves edits without recalculating ROM checksums.</description>
    <author>VQ HR ECU project</author>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="8" sigdigits="2" outputtype="1" signed="0" lsbfirst="0" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x180000" regioncolor="0x0" regionflags="0x0" name="Binary File" desc="Exact 1EK7A 0x180000-byte ROM image" />
    <CATEGORY index="0x0" name="Diagnostics / DTC / Disable Groups" />
    <CATEGORY index="0x1" name="Diagnostics / DTC / Individual" />
    <CATEGORY index="0x2" name="Electronic Throttle Control / Accelerator Pedal / Thresholds" />
    <CATEGORY index="0x3" name="Electronic Throttle Control / Requested Torque" />
    <CATEGORY index="0x4" name="Electronic Throttle Control / Throttle Geometry" />
    <CATEGORY index="0x5" name="Fuelling / Compensation" />
    <CATEGORY index="0x6" name="Fuelling / Deceleration Fuel Cut" />
    <CATEGORY index="0x7" name="Fuelling / Injection" />
    <CATEGORY index="0x8" name="Fuelling / Load Model" />
    <CATEGORY index="0x9" name="Fuelling / MAF Scaling" />
    <CATEGORY index="0xA" name="Fuelling / Target Mixture" />
    <CATEGORY index="0xB" name="Ignition / State and Event Corrections" />
    <CATEGORY index="0xC" name="Ignition / Timing Model Corrections" />
    <CATEGORY index="0xD" name="Ignition Timing / Knock Control / Thresholds" />
    <CATEGORY index="0xE" name="Ignition Timing / State Corrections" />
    <CATEGORY index="0xF" name="Ignition Timing / State Surfaces" />
    <CATEGORY index="0x10" name="Limiters / Engine Speed / Driving" />
    <CATEGORY index="0x11" name="Limiters / Engine Speed / Stationary" />
    <CATEGORY index="0x12" name="Torque Model / Engine Torque" />
    <CATEGORY index="0x13" name="Variable Valve Timing / Intake CVTC" />
    <CATEGORY index="0x14" name="Variable Valve Timing / Intake Cam" />
    <CATEGORY index="0x15" name="Variable Valve Timing / VVEL Duration" />
    <CATEGORY index="0x16" name="Variable Valve Timing / VVEL Idle Model" />
    <CATEGORY index="0x17" name="Variable Valve Timing / VVEL Mode Selection" />
    <CATEGORY index="0x18" name="Variable Valve Timing / VVEL Shaft Angle" />
  </XDFHEADER>
