{
  "kb-guard": {
    "PreToolUse": [
      {
        "matcher": "read_file|edit_file|write_file|run_command|view_file|view_file_outline|view_code_item|write_to_file|replace_file_content|multi_replace_file_content|grep_search|find_by_name|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "kb_hook_root=\"$(git rev-parse --show-toplevel)\" || exit 1; kb_hook_python=\"$kb_hook_root/.venv/bin/python\"; [ -x \"$kb_hook_python\" ] || kb_hook_python=python3; exec \"$kb_hook_python\" \"$kb_hook_root/tools/kb/hook.py\""
          }
        ]
      }
    ]
  }
}
