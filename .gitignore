# macOS / editors
.DS_Store
*.swp
*~

# KiCad local state and automatic backups
*.kicad_prl
*-backups/
.history/
*.kicad_sch-bak
*.kicad_pcb-bak

# Temporary / scratch
scratch/
tmp/
*.tmp
*.log

# ── Python ─────────────────────────────────────────────────────
# Interpreter bytecode cache; recreated on import.
__pycache__/
.venv/

# Regenerable reverse-engineering tool caches
# Large working data can be recreated from source and is not versioned:
# Ghidra project databases (the raw image is reanalyzed) and persistent Memgraph
# data (reloaded from Ghidra CSV exports).
*.rep/
*.gpr.lock
ghidra_projects/
tools/memgraph/data/

# Per-worktree state of the kb tool: caches, lock, and graph instance.
.kb/

# The project hook settings register the kb access guard and are tracked;
# local settings stay untracked.
/.mcp.json
/.claude/settings.local.json
!.claude/settings.json
!.codex/hooks.json
!.agents/hooks.json
!.agents/mcp_config.json

# Local Memgraph backup destination and state.
tools/memgraph/backup.local.toml
tools/memgraph/backup.state.json
tools/memgraph/backup.lock

# Local copies of vendor reference documents.
/refs/local/
