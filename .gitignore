# macOS / editors
.DS_Store
*.swp
*~

# KiCad local state and automatic backups
*.kicad_prl
*-backups/
.history/
*.kicad_sch-bak
*.kicad_pcb-bak

# Temporary / scratch
scratch/
tmp/
*.tmp
*.log

# ── Python ─────────────────────────────────────────────────────
# Interpreter bytecode cache; recreated on import.
__pycache__/

# ── Project-scoped Claude definitions ───────────────────────────
# The global excludesfile hides .claude/*; these definitions are part of the
# reproducible A/B execution contract and are versioned in the project.
!.claude/
!.claude/agents/
.claude/agents/*
!.claude/agents/vq-ab-blind-worker.md
!.claude/workflows/
.claude/workflows/*
!.claude/workflows/vq-caller-prep.js
!.claude/workflows/vq-caller-run.js
!.claude/workflows/vq-caller-score.js

# Regenerable reverse-engineering tool caches
# Large working data can be recreated from source and is not versioned:
# Ghidra project databases (the raw image is reanalyzed) and persistent Memgraph
# data (reloaded from Ghidra CSV exports).
*.rep/
*.gpr.lock
ghidra_projects/
tools/memgraph/data/

# Local Memgraph backup destination and state.
tools/memgraph/backup.local.toml
tools/memgraph/backup.state.json
tools/memgraph/backup.lock

# Content artifacts (ROM dumps, datasheets/PDFs, definitions, wiki mirrors, and
# disassembly exports) are versioned and therefore have no ignore rules.
