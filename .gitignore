# ── macOS / редакторы ──────────────────────────────────────────
.DS_Store
*.swp
*~

# ── Временное / scratch ────────────────────────────────────────
scratch/
tmp/
*.tmp
*.log

# ── Python ─────────────────────────────────────────────────────
# Байткод-кэш интерпретатора; пересоздаётся импортом.
__pycache__/

# ── Project-scoped Claude definitions ───────────────────────────
# Глобальный excludesfile скрывает .claude/*; эти definitions являются частью
# воспроизводимого A/B execution contract и версионируются в проекте.
!.claude/
!.claude/agents/
.claude/agents/*
!.claude/agents/vq-ab-blind-worker.md
!.claude/workflows/
.claude/workflows/*
!.claude/workflows/vq-caller-prep.js
!.claude/workflows/vq-caller-run.js
!.claude/workflows/vq-caller-score.js

# ── Регенерируемые кэши RE-инструментов ────────────────────────
# Крупные рабочие данные, восстанавливаются из исходников, в git не
# версионируются: рабочие БД Ghidra (raw-образ переанализируется) и
# персистентные данные графа Memgraph (перезаливаются из CSV-экспортов Ghidra).
*.rep/
*.gpr.lock
ghidra_projects/
tools/memgraph/data/

# Локальное назначение и состояние резервного копирования Memgraph.
tools/memgraph/backup.local.toml
tools/memgraph/backup.state.json
tools/memgraph/backup.lock

# Контентные артефакты (ROM-дампы, даташиты/PDF, дефы, зеркала wiki,
# дизасм-экспорты) версионируются в git – правил игнора для них нет.
